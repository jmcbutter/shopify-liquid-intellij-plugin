<!-- ----------------------------------------
-- CASE/ELSE
---------------------------------------- -->
{% case product.type %}
  {% when 'Health' %}
    This is a health potion.
  {% when 'Love' %}
    This is a love potion.
  {% else %}
    This is a potion.
{% endcase %}

<!-- Case w/ Multiple Values -->
{% case variable %}
  {% when first_value or second_value or third_value %}
    first_expression
  {% when fourth_value, fifth_value, sixth_value %}
    second_expression
  {% else %}
    third_expression
{% endcase %}


<!-- ----------------------------------------
-- IF/ELSIF
---------------------------------------- -->
{% if product.type == 'Love' %}
  This is a love potion!
{% elsif product.type == 'Health' %}
  This is a health potion!
{% endif %}


<!-- ----------------------------------------
-- UNLESS
---------------------------------------- -->
{% unless product.has_only_default_variant %}
  // Variant selection functionality
{% endunless %}

<!-- ----------------------------------------
-- FORM
---------------------------------------- -->
<!-- Activate Customer Password -->
{% form 'activate_customer_password', article %}
  form_content
{% endform %}

<!-- Customer Address -->
{% form 'customer_address', customer.new_address %}
  <!-- form content -->
{% endform %}

<!-- With Attributes/Params -->
{% form 'customer_login', return_to: routes.root_url %}
  <!-- form content -->
{% endform %}

{% form "product", product, id: 'custom-id', class: 'custom-class', data-example: '100' %}
  <!-- form content -->
{% endform %}


<!-- ----------------------------------------
-- STYLE
---------------------------------------- -->
{% style %}
  .h1 {
    color: {{ settings.colors_accent_1 }};
  }
{% endstyle %}

<!-- ----------------------------------------
-- BREAK
---------------------------------------- -->
{% for i in (1..5) -%}
  {%- if i == 4 -%}
    {% break %}
  {%- else -%}
    {{ i }}
  {%- endif -%}
{%- endfor %}

<!-- ----------------------------------------
-- CONTINUE
---------------------------------------- -->
{% for i in (1..5) -%}
  {%- if i == 4 -%}
    {% continue %}
  {%- else -%}
    {{ i }}
  {%- endif -%}
{%- endfor %}

<!-- ----------------------------------------
-- CYCLE
---------------------------------------- -->
<!-- Iteration 1 -->
{% for i in (1..4) -%}
  {% cycle 'one', 'two', 'three' %}
{%- endfor %}

<!-- Iteration 2 -->
{% for i in (1..4) -%}
  {% cycle 'one', 'two', 'three' %}
{%- endfor %}

<!-- Iteration 3 -->
{% for i in (1..4) -%}
  {% cycle 'group_1': 'one', 'two', 'three' %}
{%- endfor %}

<!-- Iteration 4 -->
{% for i in (1..4) -%}
  {% cycle 'group_2': 'one', 'two', 'three' %}
{%- endfor %}


<!-- ----------------------------------------
-- FOR/ELSE
---------------------------------------- -->
<!-- With Else -->
{% for product in collection.products %}
  {{ product.title }}<br>
{% else %}
  There are no products in this collection.
{% endfor %}

<!-- With Parameters -->
{% for product in collection.products limit: 2 -%}
  {{ product.title }}
{%- endfor %}

{% for product in collection.products offset: 2 -%}
  {{ product.title }}
{%- endfor %}


<!-- With Range -->
{% for variable in (number..number) %}
  expression
{% endfor %}

{% for i in (1..3) -%}
  {{ i }}
{%- endfor %}

{%- assign lower_limit = 2 -%}
{%- assign upper_limit = 4 -%}

{% for i in (lower_limit..upper_limit) -%}
  {{ i }}
{%- endfor %}

<!-- With Reversed -->
{% for variable in array reversed %}
  expression
{% endfor %}

<!-- Forloop -->
{% for page in pages -%}
  {%- if forloop.length > 0 -%}
    {{ page.title }}{% unless forloop.last %}, {% endunless -%}
  {%- endif -%}
{% endfor %}

<!-- ----------------------------------------
-- PAGINATE
---------------------------------------- -->
{% paginate collection.products by 3, window_size: 1 %}
  {% for product in collection.products -%}
    {{ product.title }}
  {%- endfor %}

  {{- paginate | default_pagination }}
{% endpaginate %}

<!-- ----------------------------------------
-- TABLEROW
---------------------------------------- -->
{% tablerow variable in array cols: number %}
  expression
{% endtablerow %}

<table>
  {% tablerow product in collection.products offset: 2 %}
    {{ product.title }}
  {% endtablerow %}
</table>